# Optional connector timeout in milliseconds for direct runs.
AGENT_CONNECTOR_TIMEOUT_MS=120000

# Terminal bridge target. Use "Terminal" or "iTerm".
MAC_TERMINAL_APP=Terminal

# Optional command templates for connectors that do not have a built-in non-interactive runner.
# Supported placeholders:
#   {cwd}        -> workspace directory requested by the app
#   {prompt}     -> full prompt text
#   {promptFile} -> temp file path containing the prompt
#   {title}      -> scenario title
#
# Recommended approach: point these at your own local wrapper scripts so you control
# authentication, model choice, and CLI flags for OpenClaw and Hermes.
OPENCLAW_COMMAND_TEMPLATE=/Users/your-user/bin/run-openclaw --cwd {cwd} --prompt-file {promptFile}
HERMES_COMMAND_TEMPLATE=/Users/your-user/bin/run-hermes --cwd {cwd} --prompt-file {promptFile}
