{
  "name": "ai-agents-boutique",
  "version": "0.1.0",
  "description": "React prototype of a single-company AI operating system with rituals, approvals, and persistent memory.",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc --noEmit && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/server/index.js",
    "check": "npm run test && npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "typescript",
    "ai-agents",
    "simulation",
    "founder-tools",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
